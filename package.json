{
  "name": "ppt-digital-human-video",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ppt-digital-human/frontend",
    "build": "npm run build --workspace @ppt-digital-human/frontend",
    "start": "npm run start --workspace @ppt-digital-human/frontend",
    "lint": "npm run lint --workspace @ppt-digital-human/frontend",
    "typecheck": "npm run typecheck --workspace @ppt-digital-human/frontend",
    "test:unit": "npm run test:unit --workspace @ppt-digital-human/frontend",
    "test:components": "npm run test:components --workspace @ppt-digital-human/frontend",
    "test:contracts": "npm run test --workspace @ppt-digital-human/contracts",
    "backend:prepare": "python -m backend.prepare",
    "backend:approve": "python -m backend.approve",
    "backend:render": "node backend/run.mjs render",
    "backend:run": "node backend/run.mjs run",
    "backend:test": "python -m unittest discover -s backend/tests -v",
    "test": "npm run backend:test && npm run test:contracts && npm run test:unit && npm run test:components",
    "routes:check": "node scripts/routes-check.mjs"
  }
}
