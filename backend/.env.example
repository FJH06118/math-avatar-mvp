# LLM planning is optional. `backend/.env` is loaded by the Python CLI; an
# explicit process environment variable wins over this local file. Without a
# key, the pipeline uses a deterministic one-slide-per-scene fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# T0 local PostgreSQL POC only. Keep the real URL in the operating-system
# environment; never commit a password, installation path, or local data path.
PPT_DH_T0_DATABASE_URL=
PPT_DH_T0_SHADOW_DATABASE_URL=

# Stage T application service. Use a separate configured URL in normal use;
# local integration tests may point this at the same disposable development
# database used by T0. Never commit the real token or URL.
PPT_DH_DATABASE_URL=
PPT_DH_ASSET_ROOT=work/t-assets
PPT_DH_ATTEMPT_ROOT=work/t-attempts
PPT_DH_PYTHON_COMMAND=python
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
PPT_DH_INTERNAL_TOKEN=
PPT_DH_APP_PORT=4310

# Edge TTS defaults
EDGE_TTS_VOICE=zh-CN-YunxiNeural
EDGE_TTS_RATE=-8%
EDGE_TTS_PITCH=-2Hz
EDGE_TTS_CONCURRENCY=3
