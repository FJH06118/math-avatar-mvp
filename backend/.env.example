# LLM planning is optional. Without a key, the pipeline uses a deterministic
# one-slide-per-scene fallback so parsing and video generation still work.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Edge TTS defaults
EDGE_TTS_VOICE=zh-CN-YunxiNeural
EDGE_TTS_RATE=-8%
EDGE_TTS_PITCH=-2Hz
EDGE_TTS_CONCURRENCY=3
