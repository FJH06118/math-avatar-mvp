# LLM planning is optional. `backend/.env` is loaded by the Python CLI; an
# explicit process environment variable wins over this local file. Without a
# key, the pipeline uses a deterministic one-slide-per-scene fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# T0 local PostgreSQL POC only. Keep the real URL in the operating-system
# environment; never commit a password, installation path, or local data path.
PPT_DH_T0_DATABASE_URL=
PPT_DH_T0_SHADOW_DATABASE_URL=

# Edge TTS defaults
EDGE_TTS_VOICE=zh-CN-YunxiNeural
EDGE_TTS_RATE=-8%
EDGE_TTS_PITCH=-2Hz
EDGE_TTS_CONCURRENCY=3
