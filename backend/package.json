{
  "name": "@ppt-digital-human/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "start:app": "tsx app/server.ts",
    "typecheck": "tsc --noEmit",
    "test:t0": "tsx --test t0/*.test.ts",
    "test:integration": "tsx --test app/*.integration.test.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@hono/node-server": "2.0.12",
    "@ppt-digital-human/contracts": "0.1.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "ffprobe-static": "3.1.0",
    "hono": "4.12.31",
    "node-edge-tts": "1.2.10",
    "pg": "8.22.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "prisma": "7.9.1",
    "tsx": "4.23.2",
    "typescript": "5.9.3"
  }
}
