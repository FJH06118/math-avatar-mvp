generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum T0TaskStatus {
  CREATED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum T0StepStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum T0AttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model T0Task {
  id                      String       @id
  principal               String
  kind                    String
  idempotencyKey          String
  inputHash               String
  status                  T0TaskStatus @default(CREATED)
  cancellationRequestedAt DateTime?
  statusVersion           Int          @default(0)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  outbox                  T0Outbox[]
  steps                   T0TaskStep[]

  @@unique([principal, kind, idempotencyKey])
}

model T0Outbox {
  id         String   @id
  taskId     String
  eventKey   String   @unique
  eventType  String
  payload    Json
  publishedAt DateTime?
  createdAt  DateTime @default(now())
  task       T0Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model T0TaskStep {
  id               String       @id
  taskId           String
  stage            String
  slideId          String?
  status           T0StepStatus @default(QUEUED)
  currentAttempt   Int          @default(0)
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  heartbeatAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  task             T0Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attempts         T0TaskStepAttempt[]
}

model T0TaskStepAttempt {
  id          String          @id
  taskStepId  String
  attempt     Int
  workerId    String
  status      T0AttemptStatus @default(RUNNING)
  startedAt   DateTime        @default(now())
  heartbeatAt DateTime?
  completedAt DateTime?
  taskStep    T0TaskStep      @relation(fields: [taskStepId], references: [id], onDelete: Cascade)

  @@unique([taskStepId, attempt])
}

enum ProjectLifecycle {
  DRAFT
  PARSING
  READY
  FAILED
  ARCHIVED
}

enum PresentationParseLifecycle {
  PENDING
  PARSING
  COMPLETED
  FAILED
}

enum AssetLifecycle {
  AVAILABLE
  INVALID
  ORPHANED
}

enum GenerationTaskStatus {
  CREATED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum GenerationTaskStage {
  PARSE
  PLAN
  AUDIO
  PAGE_RENDER
  COMPOSITE
  VALIDATE
}

model Project {
  id            String           @id
  principal     String
  title         String
  status        ProjectLifecycle @default(DRAFT)
  version       Int              @default(1)
  settings      Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assets        Asset[]
  presentations Presentation[]
  slides        Slide[]
  lessonPlans   LessonPlan[]
  tasks         GenerationTask[]

  @@index([principal, updatedAt])
}

model ProviderProfile {
  id            String   @id
  principal     String
  displayName   String
  kind          String
  protocol      String
  baseUrl       String
  model         String
  enabled       Boolean  @default(true)
  isDefault     Boolean  @default(false)
  capabilities  Json     @default("[]")
  version       Int      @default(1)
  credentialRef String   @unique
  keyConfigured Boolean  @default(false)
  keyLast4      String?
  keyVersion    Int      @default(0)
  lastTestAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([principal, updatedAt])
  @@index([principal, isDefault])
}

model Asset {
  id          String         @id
  projectId   String
  taskId      String?
  kind        String
  storageKey  String         @unique
  sha256      String
  mimeType    String
  fileSize    Int
  lifecycle   AssetLifecycle @default(AVAILABLE)
  createdAt   DateTime       @default(now())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  presentations Presentation[]
  renderedSlides Slide[]
  audioSegments AudioSegment[]
  audioTimelines AudioTimelineRecord[]
  pageFrames RenderedPage[] @relation("RenderedPageFrame")
  pageVideos RenderedPage[] @relation("RenderedPageVideo")
  finalVideos MediaOutput[] @relation("MediaOutputVideo")
  mediaCaptions MediaOutput[] @relation("MediaOutputCaptions")

  @@unique([projectId, kind, sha256])
}

model Presentation {
  id               String                     @id
  projectId        String
  sourceAssetId    String
  originalFileName String
  sha256           String
  fileSize         Int
  mimeType         String
  slideCount       Int                        @default(0)
  width            Float?
  height           Float?
  aspectRatio      Float?
  parseStatus      PresentationParseLifecycle @default(PENDING)
  parserVersion    String
  revision         Int                        @default(1)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  project          Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAsset      Asset                      @relation(fields: [sourceAssetId], references: [id], onDelete: Restrict)
  tasks            GenerationTask[]
  slides           Slide[]
  lessonPlans      LessonPlan[]
}

model Slide {
  id              String       @id
  projectId       String
  presentationId  String
  slideNumber     Int
  title           String
  slideType       String
  extractedText   String
  notes           String
  formulaJson     Json
  renderAssetId   String?
  parseConfidence Float        @default(1)
  parseWarnings   Json
  revision        Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  presentation    Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  renderAsset     Asset?       @relation(fields: [renderAssetId], references: [id], onDelete: SetNull)
  lessonPlan      LessonPlan?

  @@unique([presentationId, slideNumber])
  @@index([projectId, slideNumber])
}

model LessonPlan {
  id              String       @id
  projectId       String
  presentationId  String
  slideId         String       @unique
  currentRevision Int          @default(0)
  isLocked        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  presentation    Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  slide           Slide        @relation(fields: [slideId], references: [id], onDelete: Cascade)
  revisions       LessonPlanRevision[]

  @@index([projectId, presentationId])
}

model LessonPlanRevision {
  id              String     @id
  lessonPlanId    String
  slideId         String
  revision        Int
  payload         Json
  inputHash       String
  outputHash      String
  modelProvider   String
  modelName       String
  promptVersion   String
  schemaVersion   String
  createdBy       String
  approvalStatus  String     @default("pending")
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime   @default(now())
  lessonPlan      LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  scenes          PlannedScene[]
  audioSegments   AudioSegment[]
  renderedPages   RenderedPage[]

  @@unique([lessonPlanId, revision])
  @@index([slideId, createdAt])
}

model PlannedScene {
  id          String             @id
  revisionId  String
  slideId     String
  sceneOrder  Int
  payload     Json
  createdAt   DateTime           @default(now())
  revision    LessonPlanRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, sceneOrder])
  @@index([slideId])
}

model GenerationTask {
  id                      String               @id
  principal               String
  projectId               String
  presentationId          String
  kind                    String
  idempotencyKey          String
  inputHash               String
  configHash              String
  status                  GenerationTaskStatus @default(CREATED)
  stage                   GenerationTaskStage  @default(PARSE)
  progressCompleted       Int                  @default(0)
  progressTotal           Int                  @default(1)
  presentationRevision    Int                  @default(1)
  retryCount              Int                  @default(0)
  cancellationRequestedAt DateTime?
  heartbeatAt             DateTime?
  leaseExpiresAt          DateTime?
  statusVersion           Int                  @default(1)
  startedAt               DateTime?
  completedAt             DateTime?
  errorCode               String?
  errorMessage            String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  project                 Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  presentation            Presentation         @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  assets                  Asset[]
  outbox                  TaskOutbox[]
  steps                   GenerationTaskStep[]
  audioSegments           AudioSegment[]
  subtitleCues            SubtitleCue[]
  audioTimeline           AudioTimelineRecord?
  renderedPages           RenderedPage[]
  mediaOutput             MediaOutput?

  @@unique([principal, kind, idempotencyKey])
  @@index([principal, projectId, updatedAt])
}

model AudioSegment {
  id             String             @id
  taskId         String
  projectId      String
  presentationId String
  revisionId     String
  slideId        String
  narrationId    String
  slideOrder     Int
  segmentOrder   Int
  displayText    String
  spokenText     String
  durationMs     Int
  assetId        String
  sha256         String
  voice          String
  rate           String
  pitch          String
  inputHash      String
  timingMetadata Json?
  createdAt      DateTime           @default(now())
  task           GenerationTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  revision       LessonPlanRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  asset          Asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  subtitleCue    SubtitleCue?

  @@unique([taskId, narrationId])
  @@index([taskId, slideOrder, segmentOrder])
  @@index([projectId, presentationId])
}

model SubtitleCue {
  id             String         @id
  taskId         String
  audioSegmentId String         @unique
  cueIndex       Int
  startMs        Int
  endMs          Int
  text           String
  createdAt      DateTime       @default(now())
  task           GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  audioSegment   AudioSegment   @relation(fields: [audioSegmentId], references: [id], onDelete: Cascade)

  @@unique([taskId, cueIndex])
  @@index([taskId, startMs])
}

model AudioTimelineRecord {
  id              String         @id
  taskId          String         @unique
  srtAssetId      String
  totalDurationMs Int
  createdAt       DateTime       @default(now())
  task            GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  srtAsset        Asset          @relation(fields: [srtAssetId], references: [id], onDelete: Restrict)
}

model RenderedPage {
  id              String             @id
  taskId          String
  slideId         String
  revisionId      String
  pageOrder       Int
  durationMs      Int
  fps             Int
  width           Int
  height          Int
  frameAssetId    String
  videoAssetId    String
  frameSha256     String
  videoSha256     String
  avatarPlacement String
  overlayType     String?
  inputHash       String
  avatarId        String             @default("avatar-zhou")
  avatarAssetVersion String          @default("legacy-static-v1")
  lipSyncTimeline Json?
  lipSyncTimelineHash String?
  createdAt       DateTime           @default(now())
  task            GenerationTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  revision        LessonPlanRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  frameAsset      Asset              @relation("RenderedPageFrame", fields: [frameAssetId], references: [id], onDelete: Restrict)
  videoAsset      Asset              @relation("RenderedPageVideo", fields: [videoAssetId], references: [id], onDelete: Restrict)

  @@unique([taskId, slideId])
  @@unique([taskId, pageOrder])
  @@index([taskId, pageOrder])
}

model MediaOutput {
  id              String         @id
  taskId          String         @unique
  renderTaskId    String
  audioTaskId     String
  videoAssetId    String
  captionsAssetId String
  totalDurationMs Int
  fps             Int
  status          String
  inputHash       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  task            GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  videoAsset      Asset          @relation("MediaOutputVideo", fields: [videoAssetId], references: [id], onDelete: Restrict)
  captionsAsset   Asset          @relation("MediaOutputCaptions", fields: [captionsAssetId], references: [id], onDelete: Restrict)
  validation      MediaValidationRecord?
}

model MediaValidationRecord {
  id        String      @id
  outputId  String      @unique
  status    String
  report    Json
  createdAt DateTime    @default(now())
  output    MediaOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)
}

model TaskOutbox {
  id          String         @id
  taskId      String
  eventKey    String         @unique
  eventType   String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  task        GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model GenerationTaskStep {
  id                String               @id
  taskId            String
  stage             GenerationTaskStage
  slideId           String?
  status            GenerationTaskStatus @default(QUEUED)
  currentAttempt    Int                  @default(0)
  inputHash         String
  outputHash        String?
  progressCompleted Int                  @default(0)
  progressTotal     Int                  @default(1)
  workerId          String?
  heartbeatAt       DateTime?
  leaseExpiresAt    DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  task              GenerationTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attempts          TaskStepAttempt[]
}

model TaskStepAttempt {
  id          String               @id
  taskStepId  String
  attempt     Int
  workerId    String
  status      GenerationTaskStatus @default(RUNNING)
  startedAt   DateTime             @default(now())
  heartbeatAt DateTime?
  completedAt DateTime?
  errorCode   String?
  errorMessage String?
  taskStep    GenerationTaskStep   @relation(fields: [taskStepId], references: [id], onDelete: Cascade)

  @@unique([taskStepId, attempt])
}
