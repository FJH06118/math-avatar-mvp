generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum T0TaskStatus {
  CREATED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum T0StepStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum T0AttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model T0Task {
  id                      String       @id
  principal               String
  kind                    String
  idempotencyKey          String
  inputHash               String
  status                  T0TaskStatus @default(CREATED)
  cancellationRequestedAt DateTime?
  statusVersion           Int          @default(0)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  outbox                  T0Outbox[]
  steps                   T0TaskStep[]

  @@unique([principal, kind, idempotencyKey])
}

model T0Outbox {
  id         String   @id
  taskId     String
  eventKey   String   @unique
  eventType  String
  payload    Json
  publishedAt DateTime?
  createdAt  DateTime @default(now())
  task       T0Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model T0TaskStep {
  id               String       @id
  taskId           String
  stage            String
  slideId          String?
  status           T0StepStatus @default(QUEUED)
  currentAttempt   Int          @default(0)
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  heartbeatAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  task             T0Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attempts         T0TaskStepAttempt[]
}

model T0TaskStepAttempt {
  id          String          @id
  taskStepId  String
  attempt     Int
  workerId    String
  status      T0AttemptStatus @default(RUNNING)
  startedAt   DateTime        @default(now())
  heartbeatAt DateTime?
  completedAt DateTime?
  taskStep    T0TaskStep      @relation(fields: [taskStepId], references: [id], onDelete: Cascade)

  @@unique([taskStepId, attempt])
}

enum ProjectLifecycle {
  DRAFT
  PARSING
  READY
  FAILED
}

enum PresentationParseLifecycle {
  PENDING
  PARSING
  COMPLETED
  FAILED
}

enum AssetLifecycle {
  AVAILABLE
  INVALID
  ORPHANED
}

enum GenerationTaskStatus {
  CREATED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum GenerationTaskStage {
  PARSE
  PLAN
  AUDIO
  PAGE_RENDER
  COMPOSITE
  VALIDATE
}

model Project {
  id            String           @id
  principal     String
  title         String
  status        ProjectLifecycle @default(DRAFT)
  version       Int              @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assets        Asset[]
  presentations Presentation[]
  tasks         GenerationTask[]

  @@index([principal, updatedAt])
}

model Asset {
  id          String         @id
  projectId   String
  taskId      String?
  kind        String
  storageKey  String         @unique
  sha256      String
  mimeType    String
  fileSize    Int
  lifecycle   AssetLifecycle @default(AVAILABLE)
  createdAt   DateTime       @default(now())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  presentations Presentation[]

  @@unique([projectId, kind, sha256])
}

model Presentation {
  id               String                     @id
  projectId        String
  sourceAssetId    String
  originalFileName String
  sha256           String
  fileSize         Int
  mimeType         String
  slideCount       Int                        @default(0)
  width            Float?
  height           Float?
  aspectRatio      Float?
  parseStatus      PresentationParseLifecycle @default(PENDING)
  parserVersion    String
  revision         Int                        @default(1)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  project          Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAsset      Asset                      @relation(fields: [sourceAssetId], references: [id], onDelete: Restrict)
  tasks            GenerationTask[]
}

model GenerationTask {
  id                      String               @id
  principal               String
  projectId               String
  presentationId          String
  kind                    String
  idempotencyKey          String
  inputHash               String
  configHash              String
  status                  GenerationTaskStatus @default(CREATED)
  stage                   GenerationTaskStage  @default(PARSE)
  progressCompleted       Int                  @default(0)
  progressTotal           Int                  @default(1)
  presentationRevision    Int                  @default(1)
  retryCount              Int                  @default(0)
  cancellationRequestedAt DateTime?
  heartbeatAt             DateTime?
  leaseExpiresAt          DateTime?
  statusVersion           Int                  @default(1)
  startedAt               DateTime?
  completedAt             DateTime?
  errorCode               String?
  errorMessage            String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  project                 Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  presentation            Presentation         @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  assets                  Asset[]
  outbox                  TaskOutbox[]
  steps                   GenerationTaskStep[]

  @@unique([principal, kind, idempotencyKey])
  @@index([principal, projectId, updatedAt])
}

model TaskOutbox {
  id          String         @id
  taskId      String
  eventKey    String         @unique
  eventType   String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  task        GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model GenerationTaskStep {
  id                String               @id
  taskId            String
  stage             GenerationTaskStage
  slideId           String?
  status            GenerationTaskStatus @default(QUEUED)
  currentAttempt    Int                  @default(0)
  inputHash         String
  outputHash        String?
  progressCompleted Int                  @default(0)
  progressTotal     Int                  @default(1)
  workerId          String?
  heartbeatAt       DateTime?
  leaseExpiresAt    DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  task              GenerationTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
